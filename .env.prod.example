# Production environment. Copy to .env and fill in real values before deploying.

# Postgres password for the application role.
POSTGRES_PASSWORD=change-me

# The public origin the dashboard is served from. The backend uses it for the
# CORS allow-list; with the same-origin topology nothing depends on it in the
# browser, but it must still be a valid origin.
WEB_ORIGIN=https://permissionledger.example.com

# Must be true anywhere the site is served over HTTPS, otherwise the session
# cookie is sent without the Secure attribute.
COOKIE_SECURE=true

# Host port the web container is published on. Behind a load balancer or
# ingress this is usually 80 or 8080.
WEB_PORT=8080

# Only set this if the API is deliberately served from a different origin.
# Leaving it empty keeps requests relative and the session cookie first-party.
# VITE_API_BASE=
